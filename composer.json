{
    "name": "misaf/vendra-transaction",
    "description": "Wallet and ledger based financial transaction system with multi-gateway support, state-machine lifecycle and per-currency balances",
    "license": "MIT",
    "type": "vendra-module",
    "keywords": [
        "laravel",
        "filamentphp",
        "transaction"
    ],
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/misaf/vendra-transaction",
    "support": {
        "issues": "https://github.com/misaf/vendra-transaction/issues",
        "source": "https://github.com/misaf/vendra-transaction"
    },
    "require": {
        "php": "^8.3",
        "flowframe/laravel-trend": "^0.5.0",
        "lara-zeus/spatie-translatable": "^2.0.1",
        "misaf/vendra-currency": "self.version",
        "misaf/vendra-multimedia": "self.version",
        "misaf/vendra-support": "self.version",
        "spatie/eloquent-sortable": "^5.0.1",
        "spatie/laravel-activitylog": "^4.12.3",
        "spatie/laravel-model-states": "^2.11",
        "spatie/laravel-package-tools": "^1.93.1",
        "spatie/laravel-queueable-action": "^2.17",
        "spatie/laravel-sluggable": "^4.0.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.10.0",
        "laravel/boost": "^2.4.12",
        "laravel/pint": "^1.29.3",
        "misaf/vendra-testing": "self.version",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.4",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.7.5",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpstan/extension-installer": "^1.4.3"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Misaf\\VendraTransaction\\": "src/",
            "Misaf\\VendraTransaction\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Misaf\\VendraTransaction\\Database\\Factories\\": "database/factories/",
            "Misaf\\VendraTransaction\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraTransaction\\Providers\\TransactionServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "$schema": "https://getcomposer.org/schema.json"
}
